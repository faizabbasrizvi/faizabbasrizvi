{% comment %} "On the shelf this week" product grid (2b). {% endcomment %}
{{ 'fayzo-navy.css' | asset_url | stylesheet_tag }}
<div class="fz">
  <div class="fz-container">
    <div class="fz-shelf-head">
      <div>
        <h2 class="fz-h2">{{ section.settings.heading }}</h2>
        <p>{{ section.settings.subheading }}</p>
      </div>
      <a href="{{ section.settings.collection.url | default: routes.all_products_collection_url }}" class="fz-shelf-head__link">
        {{ section.settings.view_all_label }}
      </a>
    </div>
    <div class="fz-product-grid">
      {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
        <div class="fz-product-card">
          <a href="{{ product.url }}" class="fz-product-card__media">
            {%- if forloop.first -%}
              <span class="fz-product-card__badge">#1 seller</span>
            {%- endif -%}
            {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', alt: product.title }}
          </a>
          <div class="fz-product-card__body">
            {%- if product.metafields.reviews.rating.value != blank -%}
              <div class="fz-product-card__rating">
                <span class="fz-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                {{ product.metafields.reviews.rating.value }} ({{ product.metafields.reviews.rating_count }})
              </div>
            {%- endif -%}
            <a href="{{ product.url }}" class="fz-product-card__title">{{ product.title }}</a>
            {%- if product.metafields.fayzo.benefit_statement.value != blank -%}
              <p class="fz-product-card__desc">{{ product.metafields.fayzo.benefit_statement.value }}</p>
            {%- endif -%}
            <div class="fz-product-card__foot">
              <span class="fz-product-card__price">{{ product.price | money }}</span>
              {%- form 'product', product -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="fz-product-card__add"{% unless product.selected_or_first_available_variant.available %} disabled{% endunless %}>
                  {%- if product.selected_or_first_available_variant.available -%}Add{%- else -%}Sold out{%- endif -%}
                </button>
              {%- endform -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fayzo navy shelf grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "On the shelf this week" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Every one has a verdict. When something stops earning its place, it goes." },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "See all 11" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "default": 4, "label": "Products to show" }
  ],
  "presets": [{ "name": "Fayzo navy shelf grid" }]
}
{% endschema %}

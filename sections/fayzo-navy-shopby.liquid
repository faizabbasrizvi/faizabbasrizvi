{% comment %} "Shop by the thing that's annoying you" (2b). {% endcomment %}
{{ 'fayzo-navy.css' | asset_url | stylesheet_tag }}
<div class="fz">
  <div class="fz-container fz-shopby">
    <div class="fz-shopby__intro">
      <h2>{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    <div class="fz-shopby__grid">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'problem' -%}
            <a href="{{ block.settings.link | default: '#' }}" class="fz-shopby__tile" {{ block.shopify_attributes }}>
              <div class="fz-shopby__tile-title">{{ block.settings.title }}</div>
              <div class="fz-shopby__tile-meta">{{ block.settings.meta }}</div>
            </a>
          {%- when 'cta' -%}
            <a href="{{ block.settings.link | default: '#' }}" class="fz-shopby__tile fz-shopby__tile--cta" {{ block.shopify_attributes }}>
              {{ block.settings.label }} &rarr;
            </a>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Fayzo navy shop-by",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by the thing that's annoying you" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "People arrive with a problem, not a product. The catalog is organised that way." }
  ],
  "blocks": [
    {
      "type": "problem",
      "name": "Problem tile",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "meta", "label": "Meta line" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "cta",
      "name": "Dashed CTA tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Fayzo navy shop-by",
      "blocks": [
        { "type": "problem", "settings": { "title": "My back hurts by 4pm", "meta": "3 products · from AED 89" } },
        { "type": "problem", "settings": { "title": "The AC dries me out", "meta": "2 products · from AED 89" } },
        { "type": "problem", "settings": { "title": "I crash at 3pm", "meta": "2 products · from AED 79" } },
        { "type": "problem", "settings": { "title": "My desk is a mess", "meta": "2 products · from AED 65" } },
        { "type": "problem", "settings": { "title": "I sleep badly", "meta": "2 products · from AED 75" } },
        { "type": "cta", "settings": { "label": "Tell us what to test next" } }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Generic, data-driven product page. Every option/variant/price/description
  comes straight from `product` — nothing here is hardcoded to a specific
  product. Uses Dawn's own variant-selects + buy-buttons + product-form.js
  for cart handling (proven, AJAX, cart-drawer aware) restyled to match the
  fz-navy design system. If a product has only its default variant, the
  variant picker renders nothing at all — no fake sizes/bundles.

  Editorial content (verdict, problem, checklist, stats, cross-sell) is all
  optional blocks with empty defaults, so a new product shows only what you
  actually configure for it. Products that need distinctly different
  editorial content should use their own template (Product admin > Theme
  template dropdown) — see templates/product.posture-belt.json and
  templates/product.cinemafold.json for examples.
{% endcomment %}
{{ 'fayzo-navy.css' | asset_url | stylesheet_tag }}
{{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'fz-product.js' | asset_url }}" defer="defer"></script>
{%- liquid
  assign product_form_id = 'product-form-' | append: section.id
  assign has_checklist = false
  assign has_crosssell = false
  for block in section.blocks
    if block.type == 'checklist_item'
      assign has_checklist = true
    endif
    if block.type == 'crosssell_item' and block.settings.product != blank
      assign has_crosssell = true
    endif
  endfor
-%}
<div class="fz" id="fayzo-product-top">
  <div class="fz-pdp__grid">
    <div class="fz-pdp__gallery">
      <div class="fz-pdp__main-media" id="FzMainMedia-{{ section.id }}">
        {%- if product.featured_media -%}
          {{ product.featured_media | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title }}
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'badge' and block.settings.text != blank -%}
            <span class="fz-pdp__badge" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="fz-pdp__thumbs">
          {%- for media in product.media limit: 8 -%}
            <button
              type="button"
              class="fz-pdp__thumb{% if forloop.first %} fz-pdp__thumb--active{% endif %}"
              data-full="{{ media | image_url: width: 900 }}"
            >
              {{ media | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="fz-pdp__info">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'eyebrow' -%}
            {%- if block.settings.text != blank -%}
              <div class="fz-eyebrow" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
            {%- endif -%}

          {%- when 'rating' -%}
            {%- if block.settings.score != blank -%}
              <div class="fz-pdp__rating-row" {{ block.shopify_attributes }}>
                <span class="fz-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                {{ block.settings.score }}
                {%- if block.settings.count_label != blank -%}
                  &middot; {{ block.settings.count_label }}
                {%- endif -%}
              </div>
            {%- endif -%}

          {%- when 'hook' -%}
            {%- if block.settings.text != blank -%}
              <p class="fz-pdp__lede" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
            {%- endif -%}

          {%- when 'buy_box' -%}
            <h1 class="fz-pdp__title">{{ product.title }}</h1>
            <div class="fz-pdp__buybox" data-fz-buybox {{ block.shopify_attributes }}>
              {%- render 'product-variant-picker', product: product, block: block, product_form_id: product_form_id -%}

              <div class="fz-pdp__price">
                <span data-fz-price>{{ product.selected_or_first_available_variant.price | money }}</span>
                <s
                  data-fz-compare-price
                  {%- unless product.selected_or_first_available_variant.compare_at_price
                    > product.selected_or_first_available_variant.price
                  %}
                    hidden
                  {%- endunless -%}
                >{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
              </div>

              {%- if block.settings.delivery_line_1 != blank or block.settings.delivery_line_2 != blank -%}
                <div class="fz-delivery-cards">
                  {%- if block.settings.delivery_line_1 != blank -%}
                    <div class="fz-delivery-card">
                      <div class="fz-delivery-card__title">{{ block.settings.delivery_line_1 }}</div>
                      {%- if block.settings.delivery_line_1_desc != blank -%}
                        <div class="fz-delivery-card__desc">{{ block.settings.delivery_line_1_desc }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.delivery_line_2 != blank -%}
                    <div class="fz-delivery-card">
                      <div class="fz-delivery-card__title">{{ block.settings.delivery_line_2 }}</div>
                      {%- if block.settings.delivery_line_2_desc != blank -%}
                        <div class="fz-delivery-card__desc">{{ block.settings.delivery_line_2_desc }}</div>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- render 'buy-buttons',
                product: product,
                product_form_id: product_form_id,
                section_id: section.id,
                show_pickup_availability: false
              -%}

              <button
                type="button"
                class="fz-cta-amber"
                data-fz-buy-now
                {% if product.selected_or_first_available_variant.available == false or product.selected_or_first_available_variant == null %}
                  disabled
                {% endif %}
              >Buy now &mdash; Apple Pay</button>

              <div class="fz-payment-row">
                <span class="fz-payment-chip">VISA</span>
                <span class="fz-payment-chip">MC</span>
                <span class="fz-payment-chip">TABBY</span>
                <span class="fz-payment-chip">APPLE PAY</span>
                <span class="fz-payment-chip">COD</span>
              </div>

              <script type="application/json" data-fz-variants>
                [
                  {%- for v in product.variants -%}
                    {%- assign v_on_sale = false -%}
                    {%- if v.compare_at_price > v.price -%}{%- assign v_on_sale = true -%}{%- endif -%}
                    {
                      "id": {{ v.id | json }},
                      "options": {{ v.options | json }},
                      "available": {{ v.available | json }},
                      "price": {{ v.price | money | json }},
                      "compare_at_price": {{ v.compare_at_price | money | json }},
                      "on_sale": {{ v_on_sale | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              </script>
            </div>

          {%- when 'verdict' -%}
            {%- if block.settings.good_for != blank or block.settings.not_for != blank -%}
              <div class="fz-verdict" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <div class="fz-eyebrow">{{ block.settings.heading }}</div>
                {%- endif -%}
                <div class="fz-verdict__grid">
                  {%- if block.settings.good_for != blank -%}
                    <div><div class="fz-buy">Good for</div><div style="margin-top:4px">{{ block.settings.good_for }}</div></div>
                  {%- endif -%}
                  {%- if block.settings.not_for != blank -%}
                    <div><div class="fz-skip">Not for</div><div style="margin-top:4px">{{ block.settings.not_for }}</div></div>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="fz-pdp__description rte" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if has_crosssell -%}
    <div class="fz-crosssell">
      <div>
        <div class="fz-crosssell__title">{{ section.settings.crosssell_heading }}</div>
        {%- if section.settings.crosssell_subheading != blank -%}
          <div class="fz-crosssell__sub">{{ section.settings.crosssell_subheading }}</div>
        {%- endif -%}
      </div>
      <div class="fz-crosssell__items">
        {%- for block in section.blocks -%}
          {%- if block.type == 'crosssell_item' and block.settings.product != blank -%}
            {%- assign cs_product = block.settings.product -%}
            <div class="fz-crosssell__item" {{ block.shopify_attributes }}>
              <div class="fz-crosssell__item-img">
                {%- if cs_product.featured_image -%}
                  {{ cs_product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: cs_product.title }}
                {%- endif -%}
              </div>
              <div>
                <div class="fz-crosssell__item-title">{{ cs_product.title }}</div>
                <div class="fz-crosssell__item-price">
                  {{ cs_product.price | money }}
                  {%- if cs_product.compare_at_price > cs_product.price -%}
                    <s>{{ cs_product.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>
              </div>
              {%- form 'product', cs_product -%}
                <input type="hidden" name="id" value="{{ cs_product.selected_or_first_available_variant.id }}">
                <button type="submit" class="fz-crosssell__item-add">Add</button>
              {%- endform -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.problem_heading != blank -%}
    <div class="fz-problem">
      {%- if section.settings.problem_image != blank -%}
        <div class="fz-problem__media">
          {{ section.settings.problem_image | image_url: width: 1400 | image_tag: loading: 'lazy', alt: section.settings.problem_heading }}
        </div>
      {%- endif -%}
      <div class="fz-problem__copy">
        <div class="fz-eyebrow fz-eyebrow--orange">The actual problem</div>
        <h2>{{ section.settings.problem_heading }}</h2>
        {%- if section.settings.problem_text_1 != blank -%}<p>{{ section.settings.problem_text_1 }}</p>{%- endif -%}
        {%- if section.settings.problem_text_2 != blank -%}<p>{{ section.settings.problem_text_2 }}</p>{%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- if has_checklist -%}
    <div class="fz-checklist">
      {%- if section.settings.checklist_heading != blank -%}<h2>{{ section.settings.checklist_heading }}</h2>{%- endif -%}
      <div class="fz-checklist__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'checklist_item' -%}
            <div {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="fz-checklist__media">
                  {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: block.settings.title }}
                </div>
              {%- endif -%}
              <div class="fz-checklist__title">{{ block.settings.title }}</div>
              <p class="fz-checklist__desc">{{ block.settings.description }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  {%- if section.settings.stats_heading != blank -%}
    <div class="fz-stats fz-stats--section">
      <div class="fz-container fz-stats__head">
        <h2>{{ section.settings.stats_heading }}</h2>
      </div>
      <div class="fz-container fz-stats__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="fz-stat" {{ block.shopify_attributes }}>
              <div class="fz-stat__num">{{ block.settings.number }}</div>
              <div class="fz-stat__desc">{{ block.settings.description }}</div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
      {%- if section.settings.stats_footnote != blank -%}
        <div class="fz-container fz-stats__footnote">{{ section.settings.stats_footnote }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- render 'fayzo-navy-sticky-atc', product: product -%}
</div>

{% schema %}
{
  "name": "t:sections.main-product.name",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "crosssell_heading", "label": "Cross-sell heading", "default": "You might also like" },
    { "type": "text", "id": "crosssell_subheading", "label": "Cross-sell subheading" },
    { "type": "image_picker", "id": "problem_image", "label": "Problem section image" },
    { "type": "text", "id": "problem_heading", "label": "Problem heading", "info": "Leave blank to hide this whole section." },
    { "type": "textarea", "id": "problem_text_1", "label": "Problem paragraph 1" },
    { "type": "textarea", "id": "problem_text_2", "label": "Problem paragraph 2" },
    { "type": "text", "id": "checklist_heading", "label": "Checklist heading" },
    { "type": "url", "id": "whatsapp_link", "label": "WhatsApp link (for the mobile sticky bar)", "info": "Leave blank to hide the WhatsApp button." },
    { "type": "text", "id": "stats_heading", "label": "Stats heading", "info": "Leave blank to hide this whole section. Only use real numbers." },
    { "type": "textarea", "id": "stats_footnote", "label": "Stats footnote" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Gallery badge",
      "settings": [
        { "type": "text", "id": "text", "label": "Badge text", "info": "e.g. \"Best seller\" — only use if true." }
      ]
    },
    {
      "type": "eyebrow",
      "name": "Eyebrow text",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    },
    {
      "type": "rating",
      "name": "Rating summary",
      "settings": [
        { "type": "text", "id": "score", "label": "Score", "info": "e.g. 4.7 — leave blank if you have no reviews yet." },
        { "type": "text", "id": "count_label", "label": "Count label", "info": "e.g. \"212 reviews\"" }
      ]
    },
    {
      "type": "hook",
      "name": "Hook line",
      "settings": [{ "type": "textarea", "id": "text", "label": "Short hook / lede text" }]
    },
    {
      "type": "buy_box",
      "name": "Buy box (variants + cart)",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "picker_type",
          "label": "Option picker style",
          "options": [
            { "value": "button", "label": "Buttons" },
            { "value": "dropdown", "label": "Dropdown" },
            { "value": "swatch", "label": "Swatches" }
          ],
          "default": "button"
        },
        {
          "type": "select",
          "id": "swatch_shape",
          "label": "Swatch shape",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" },
            { "value": "none", "label": "None" }
          ],
          "default": "none"
        },
        { "type": "text", "id": "delivery_line_1", "label": "Delivery card 1 title" },
        { "type": "text", "id": "delivery_line_1_desc", "label": "Delivery card 1 description" },
        { "type": "text", "id": "delivery_line_2", "label": "Delivery card 2 title" },
        { "type": "text", "id": "delivery_line_2_desc", "label": "Delivery card 2 description" }
      ]
    },
    {
      "type": "verdict",
      "name": "Our take / verdict",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Our take" },
        { "type": "textarea", "id": "good_for", "label": "Good for" },
        { "type": "textarea", "id": "not_for", "label": "Not for" }
      ]
    },
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "crosssell_item",
      "name": "Cross-sell product",
      "settings": [{ "type": "product", "id": "product", "label": "Product" }]
    },
    {
      "type": "checklist_item",
      "name": "Checklist item",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "info": "e.g. \"41\" — only use real, measured data." },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-product.name",
      "blocks": [{ "type": "buy_box" }, { "type": "description" }]
    }
  ]
}
{% endschema %}

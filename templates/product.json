{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "benefit_statement": {
          "type": "benefit_statement"
        },
        "rating": {
          "type": "rating"
        },
        "price": {
          "type": "price"
        },
        "payment_badges": {
          "type": "payment_badges"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "trust_row": {
          "type": "icon-with-text",
          "settings": {
            "layout": "horizontal",
            "icon_1": "box",
            "heading_1": "Curated finds",
            "icon_2": "star",
            "heading_2": "Real reviews",
            "icon_3": "truck",
            "heading_3": "Fast UAE delivery"
          }
        },
        "benefits_list": {
          "type": "benefits_list"
        },
        "specifics": {
          "type": "specifics"
        },
        "faq_shipping": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & delivery",
            "icon": "truck",
            "content": "<p>We deliver across the UAE in 2–4 days.</p>"
          }
        },
        "faq_payment": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Payment options",
            "icon": "lock",
            "content": "<p>Cash on delivery is available on every order. Tabby and Tamara Buy Now, Pay Later are also available at checkout where enabled.</p>"
          }
        }
      },
      "block_order": [
        "rating",
        "title",
        "benefit_statement",
        "price",
        "payment_badges",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust_row",
        "benefits_list",
        "specifics",
        "faq_shipping",
        "faq_payment"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "complementary-products": {
      "type": "complementary-products",
      "settings": {
        "heading": "Goes well with",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-2",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "complementary-products"
  ]
}

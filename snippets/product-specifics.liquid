{% comment %}
  Specifics block (PRD Section 4, step 5): "dimensions, battery life, what's
  in the box, structured via the metafield pattern from Section 8, not
  freeform paragraphs." Renders product.metafields.fayzo.specifics, a list
  of specifics_item metaobjects (label/value pairs), as a definition list —
  works for any product type without per-product custom code (PRD Section 8).
{% endcomment %}
{%- liquid
  assign specifics = product.metafields.fayzo.specifics.value
-%}
{%- if specifics != blank and specifics.size > 0 -%}
  <div class="fayzo-specifics">
    <h3 class="fayzo-specifics__heading">Specifics</h3>
    <dl class="fayzo-specifics__list">
      {%- for row in specifics -%}
        <div class="fayzo-specifics__row">
          <dt class="fayzo-specifics__label">{{ row.label.value }}</dt>
          <dd class="fayzo-specifics__value">{{ row.value.value }}</dd>
        </div>
      {%- endfor -%}
    </dl>
  </div>
{%- endif -%}

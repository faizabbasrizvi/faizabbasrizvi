{% comment %}
  One-line benefit statement under the product title (PRD Section 4, step 2):
  "not just the product name repeated." Pulls product.metafields.fayzo.benefit_statement,
  filled in per-product via the metafield admin field — see Section 8's
  fill-in-the-blank workflow.
{% endcomment %}
{%- liquid
  assign benefit = product.metafields.fayzo.benefit_statement.value
-%}
{%- if benefit != blank -%}
  <p class="fayzo-benefit-statement">{{ benefit }}</p>
{%- endif -%}

{% comment %}
  "Complete your kit" cross-sell (Fayzo Website.dc.html section 2). Reuses
  the same fayzo.related_products metafield as the existing
  complementary-products section, just in the design's compact horizontal
  card layout instead of a grid of full product cards.
{% endcomment %}
{{ 'fayzo-product-sections.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign cross_sell = product.metafields.fayzo.related_products.value
  if cross_sell == blank
    assign cross_sell = collections[product.collections.first.handle].products | where_exp: 'p', 'p.id != product.id' | slice: 0, 2
  endif
-%}
{%- if cross_sell != blank and cross_sell.size > 0 -%}
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="title title-wrapper--no-top-margin {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      <ul class="fayzo-cross-sell grid grid--2-col-tablet-down" role="list">
        {%- for cross_product in cross_sell limit: 4 -%}
          <li class="fayzo-cross-sell__item">
            <a href="{{ cross_product.url }}" class="fayzo-cross-sell__media">
              {%- if cross_product.featured_media -%}
                {{ cross_product.featured_media | image_url: width: 200 | image_tag: loading: 'lazy', sizes: '84px', widths: '84,168' }}
              {%- endif -%}
            </a>
            <div class="fayzo-cross-sell__info">
              <a href="{{ cross_product.url }}" class="fayzo-cross-sell__title">{{ cross_product.title }}</a>
              <span class="fayzo-cross-sell__price">{{ cross_product.price | money }}</span>
            </div>
            <a href="{{ cross_product.url }}" class="button button--secondary fayzo-cross-sell__view">View</a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Cross-sell",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete your kit"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }
      ],
      "default": "h2",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ]
}
{% endschema %}

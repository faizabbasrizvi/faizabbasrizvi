{% comment %}
  Sticky add-to-cart bar. Desktop: thumb + title + live price on the left,
  real Add to cart on the right. Mobile: full-width Add to cart + optional
  WhatsApp button. Fully dynamic — no hardcoded price, size, or date — and
  stays in sync with the buy box above via fz-product.js.
  Accepts `product`.
{% endcomment %}
{%- assign sticky_variant = product.selected_or_first_available_variant -%}
<div class="fz fz-sticky-desktop">
  <div class="fz-sticky-desktop__left">
    <div class="fz-sticky-desktop__thumb">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}
      {%- endif -%}
    </div>
    <div>
      <div class="fz-sticky-desktop__title">{{ product.title }}</div>
      <div class="fz-sticky-desktop__meta" data-fz-price>{{ sticky_variant.price | money }}</div>
    </div>
  </div>
  <div class="fz-sticky-desktop__right">
    {%- render 'buy-buttons',
      product: product,
      product_form_id: 'product-form-sticky-desktop',
      section_id: 'sticky-desktop',
      show_pickup_availability: false
    -%}
  </div>
</div>

<div class="fz fz-sticky-mobile">
  <div class="fz-sticky-mobile__row">
    {%- render 'buy-buttons',
      product: product,
      product_form_id: 'product-form-sticky-mobile',
      section_id: 'sticky-mobile',
      show_pickup_availability: false
    -%}
    {%- if section.settings.whatsapp_link != blank -%}
      <a href="{{ section.settings.whatsapp_link }}" class="fz-sticky-mobile__wa" aria-label="WhatsApp us">WA</a>
    {%- endif -%}
  </div>
</div>

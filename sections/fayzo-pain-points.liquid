{% comment %}
  "Sound familiar?" pain-point grid (Fayzo Website.dc.html section 5).
  Pulls product.metafields.fayzo.pain_points, a list of pain_point
  metaobjects (title/description) — mirrors the specifics/benefits
  metafield pattern already used elsewhere on the product page.
{% endcomment %}
{{ 'fayzo-product-sections.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign pain_points = product.metafields.fayzo.pain_points.value
-%}
{%- if pain_points != blank and pain_points.size > 0 -%}
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="title title-wrapper--no-top-margin {{ section.settings.heading_size }}" style="text-align:center;">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}
      <ul class="fayzo-pain-points grid grid--3-col-desktop grid--1-col-tablet-down" role="list">
        {%- for pain in pain_points -%}
          <li class="fayzo-pain-points__item">
            <div class="fayzo-pain-points__title">{{ pain.title.value }}</div>
            <div class="fayzo-pain-points__desc">{{ pain.description.value }}</div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Pain point grid",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Sound familiar?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ]
}
{% endschema %}

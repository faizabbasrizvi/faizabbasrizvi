{% comment %}
  Checklist + CTA band — used twice on the product page (Fayzo Website.dc.html
  sections 8 and 12: "Why {{product.name}}?" mid-page, and "Ready to fix it?"
  as the closing band), configured per-instance via the heading setting.
  Reuses the same fayzo.benefits metafield/checkmark styling as the
  benefits_list block on the main product info column.
{% endcomment %}
{{ 'fayzo-product-sections.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign benefits = product.metafields.fayzo.benefits.value
-%}
{%- if benefits != blank and benefits.size > 0 -%}
  <div class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}">
    <div class="page-width fayzo-checklist-cta">
      {%- if section.settings.heading != blank -%}
        <h2 class="{{ section.settings.heading_size }}">
          {{ section.settings.heading | replace: '[product]', product.title | escape }}
        </h2>
      {%- endif -%}
      <ul class="fayzo-checklist-cta__list{% if section.settings.layout == 'inline' %} fayzo-checklist-cta__list--inline{% endif %}" role="list">
        {%- for benefit in benefits -%}
          <li>
            {{- 'icon-checkmark.svg' | inline_asset_content -}}
            <span>{{ benefit }}</span>
          </li>
        {%- endfor -%}
      </ul>
      <a href="#fayzo-product-top" class="button">{{ section.settings.button_label | escape }}</a>
    </div>
  </div>

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Checklist + CTA",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Use [product] as a placeholder for the product title.",
      "default": "Why [product]?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "t:sections.all.heading_size.options__1.label" },
        { "value": "h1", "label": "t:sections.all.heading_size.options__2.label" }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "select",
      "id": "layout",
      "options": [
        { "value": "stacked", "label": "Stacked" },
        { "value": "inline", "label": "Inline" }
      ],
      "default": "stacked",
      "label": "Checklist layout"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add to Cart"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 56
    }
  ]
}
{% endschema %}

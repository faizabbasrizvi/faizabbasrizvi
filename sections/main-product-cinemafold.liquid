{% comment %}
  Dedicated product-page section for CinemaFold (3D phone-screen magnifier).
  Kept separate from sections/main-product.liquid because that file's
  copy (sizes, rating, press, "47 testers" stats) is hardcoded for the
  posture belt and none of it is true for this product. No fabricated
  reviews, ratings, best-seller badge or press mentions — this is a new
  listing with zero sales history.
{% endcomment %}
{{ 'fayzo-navy.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign img0 = product.featured_media | default: product.media[0]
  assign variant_single = product.variants.first
  assign variant_two = product.variants.last
-%}
<div class="fz" id="fayzo-product-top">
  <div class="fz-pdp__grid">
    <div class="fz-pdp__gallery">
      <div class="fz-pdp__main-media" id="FzMainMedia-{{ section.id }}">
        {%- if img0 -%}{{ img0 | image_url: width: 900 | image_tag: loading: 'eager', alt: product.title }}{%- endif -%}
        <span class="fz-pdp__badge" style="background:var(--fz-navy)">New arrival</span>
      </div>

      {%- if product.media.size > 1 -%}
        <div class="fz-pdp__thumbs">
          {%- for media in product.media limit: 5 -%}
            <button type="button" class="fz-pdp__thumb{% if forloop.first %} fz-pdp__thumb--active{% endif %}">
              {{ media | image_url: width: 300 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="fz-pdp__social-mini">
        <div class="fz-eyebrow">How it works</div>
        <div style="font:500 14px/1.6 var(--fz-sans);color:rgba(10,27,56,.8);margin-top:10px">
          1. Slide your phone into the base clip.<br>
          2. Pull the fold open until the picture is in focus.<br>
          3. The screen appears magnified 2&ndash;4&times;, hands-free.
        </div>
      </div>
    </div>

    <div class="fz-pdp__info">
      <div class="fz-eyebrow">No batteries, no app &mdash; just a lens</div>
      <h1 class="fz-pdp__title">{{ product.title }}</h1>
      <p class="fz-pdp__lede">
        Squinting at a 6-inch screen for two hours a night is why your eyes feel tired by 9pm.
        <strong>This puts the same video on a screen roughly four times the size, no charging and nothing to pair.</strong>
      </p>

      {%- form 'product', product, id: 'FzBuyForm-cf', class: 'fz-buy-form' -%}
        <input type="hidden" name="id" id="FzVariantId-{{ section.id }}" value="{{ variant_two.id | default: variant_single.id }}">
        <div class="fz-tiers">
          <label class="fz-tier">
            <input type="radio" name="fz-tier-cf" value="{{ variant_single.id }}" data-price="{{ variant_single.price | money }}" data-note="1 magnifier &middot; free delivery" style="display:none">
            <span class="fz-tier__radio"></span>
            <span class="fz-tier__body">
              <span class="fz-tier__title">Just one</span>
              <span class="fz-tier__meta">Try it first.</span>
            </span>
            <span class="fz-tier__price">{{ variant_single.price | money }}</span>
          </label>
          <label class="fz-tier">
            <input type="radio" name="fz-tier-cf" value="{{ variant_two.id }}" data-price="{{ variant_two.price | money }}" data-note="2 magnifiers &middot; free delivery" checked style="display:none">
            <span class="fz-tier__radio"></span>
            <span class="fz-tier__body">
              <span class="fz-tier__title">Two &mdash; one for you, one to gift</span>
              <span class="fz-tier__meta">Shipping one parcel instead of two costs us less, so it costs you less.</span>
            </span>
            <span class="fz-tier__price">{{ variant_two.price | money }}</span>
            <span class="fz-tier__badge">Most picked</span>
          </label>
        </div>

        <div class="fz-delivery-cards">
          <div class="fz-delivery-card">
            <div class="fz-delivery-card__title">Arrives in 2&ndash;4 days</div>
            <div class="fz-delivery-card__desc">In stock in Dubai. A real date at checkout, not an estimate from abroad.</div>
          </div>
          <div class="fz-delivery-card">
            <div class="fz-delivery-card__title">14 days to change your mind</div>
            <div class="fz-delivery-card__desc">We pay the return courier. Refuse it at the door if you like.</div>
          </div>
        </div>

        <div class="fz-verdict">
          <div class="fz-eyebrow">Our take</div>
          <div class="fz-verdict__grid">
            <div><div class="fz-buy">Good for</div><div style="margin-top:4px">Video calls, shows in bed, or reading &mdash; anywhere you want two hands free.</div></div>
            <div><div class="fz-skip">Not for</div><div style="margin-top:4px">Bright direct sunlight &mdash; like any screen, the picture washes out outdoors.</div></div>
          </div>
        </div>

        <button type="submit" class="fz-cta-navy">
          <span class="fz-cta-navy__title" id="FzCtaTitle-{{ section.id }}">Add to cart &mdash; {{ variant_two.price | money }}</span>
          <span class="fz-cta-navy__note" id="FzCtaNote-{{ section.id }}">2 magnifiers &middot; free delivery</span>
        </button>
      {%- endform -%}
      <div class="fz-payment-row">
        <span class="fz-payment-chip">VISA</span>
        <span class="fz-payment-chip">MC</span>
        <span class="fz-payment-chip">TABBY</span>
        <span class="fz-payment-chip">APPLE PAY</span>
        <span class="fz-payment-chip">COD</span>
      </div>
    </div>
  </div>

  <div class="fz-crosssell">
    <div>
      <div class="fz-crosssell__title">{{ section.settings.crosssell_heading }}</div>
      <div class="fz-crosssell__sub">{{ section.settings.crosssell_subheading }}</div>
    </div>
    <div class="fz-crosssell__items">
      {%- for block in section.blocks -%}
        {%- if block.type == 'crosssell_item' and block.settings.product -%}
          {%- assign cs_product = block.settings.product -%}
          <div class="fz-crosssell__item">
            <div class="fz-crosssell__item-img">
              {%- if cs_product.featured_image -%}
                {{ cs_product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: cs_product.title }}
              {%- endif -%}
            </div>
            <div>
              <div class="fz-crosssell__item-title">{{ cs_product.title | default: block.settings.fallback_title }}</div>
              <div class="fz-crosssell__item-price">{{ cs_product.price | money }}</div>
            </div>
            {%- form 'product', cs_product -%}
              <input type="hidden" name="id" value="{{ cs_product.selected_or_first_available_variant.id }}">
              <button type="submit" class="fz-crosssell__item-add">Add</button>
            {%- endform -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="fz-problem fz-only-desktop">
    <div class="fz-problem__media">
      {%- if img0 -%}{{ img0 | image_url: width: 1400 | image_tag: loading: 'lazy', alt: product.title }}{%- endif -%}
    </div>
    <div class="fz-problem__copy">
      <div class="fz-eyebrow fz-eyebrow--orange">The actual problem</div>
      <h2>{{ section.settings.problem_heading }}</h2>
      <p>{{ section.settings.problem_text_1 }}</p>
      <p>{{ section.settings.problem_text_2 }}</p>
    </div>
  </div>

  <div class="fz-checklist">
    <h2>{{ section.settings.checklist_heading }}</h2>
    <div class="fz-checklist__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'checklist_item' -%}
          <div>
            <div class="fz-checklist__title">{{ block.settings.title }}</div>
            <p class="fz-checklist__desc">{{ block.settings.description }}</p>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (() => {
    const form = document.getElementById('FzBuyForm-cf');
    if (!form) return;
    const idInput = document.getElementById('FzVariantId-{{ section.id }}');
    const ctaTitle = document.getElementById('FzCtaTitle-{{ section.id }}');
    const ctaNote = document.getElementById('FzCtaNote-{{ section.id }}');
    form.querySelectorAll('input[name="fz-tier-cf"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        idInput.value = radio.value;
        ctaTitle.textContent = 'Add to cart — ' + radio.dataset.price;
        ctaNote.innerHTML = radio.dataset.note;
      });
    });

    document.querySelectorAll('#fayzo-product-top .fz-pdp__thumbs').forEach((group) => {
      const main = group.closest('.fz-pdp__gallery').querySelector('.fz-pdp__main-media img');
      group.querySelectorAll('.fz-pdp__thumb').forEach((thumb) => {
        const thumbImg = thumb.querySelector('img');
        if (!thumbImg) return;
        thumb.addEventListener('click', () => {
          group.querySelectorAll('.fz-pdp__thumb--active').forEach((t) => t.classList.remove('fz-pdp__thumb--active'));
          thumb.classList.add('fz-pdp__thumb--active');
          if (main) {
            main.src = thumbImg.src;
            main.srcset = thumbImg.srcset || '';
          }
        });
      });
    });
  })();
</script>

{% schema %}
{
  "name": "CinemaFold product page",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "crosssell_heading", "label": "Cross-sell heading", "default": "Also on the shelf" },
    { "type": "text", "id": "crosssell_subheading", "label": "Cross-sell subheading", "default": "Other things people fix their desk with" },
    { "type": "text", "id": "problem_heading", "label": "Problem heading", "default": "Your phone screen is fine. It's just six inches." },
    { "type": "textarea", "id": "problem_text_1", "label": "Problem paragraph 1", "default": "Most people hold a phone 20–30cm from their face for hours of video. That's what causes the squint, and the ache behind the eyes by the end of a long show." },
    { "type": "textarea", "id": "problem_text_2", "label": "Problem paragraph 2", "default": "A bigger picture at the same distance means less squinting, not brighter light or a different phone. That's the entire idea here — a lens, not electronics." },
    { "type": "text", "id": "checklist_heading", "label": "Checklist heading", "default": "What you're actually getting" }
  ],
  "blocks": [
    {
      "type": "crosssell_item",
      "name": "Cross-sell product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "fallback_title", "label": "Fallback title" }
      ]
    },
    {
      "type": "checklist_item",
      "name": "Checklist item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "description", "label": "Description" }
      ]
    }
  ]
}
{% endschema %}

{% comment %}
  Sticky add-to-cart bar. Desktop (2a): product thumb + title/meta on the
  left, price + Add to cart on the right. Mobile (2c): full-width amber
  Add-to-cart button + WhatsApp button. Accepts `product` and `variant`.
{% endcomment %}
<div class="fz fz-sticky-desktop">
  <div class="fz-sticky-desktop__left">
    <div class="fz-sticky-desktop__thumb">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: product.title }}
      {%- endif -%}
    </div>
    <div>
      <div class="fz-sticky-desktop__title">{{ product.title }} &middot; 2-pack &middot; L/XL</div>
      <div class="fz-sticky-desktop__meta">Arrives Sun 17 Aug &middot; free delivery &middot; you save AED 39</div>
    </div>
  </div>
  <div class="fz-sticky-desktop__right">
    <span class="fz-sticky-desktop__price">AED 219</span>
    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <button type="submit" class="fz-btn fz-btn--amber" style="padding:14px 32px;font-size:15px">Add to cart</button>
    {%- endform -%}
  </div>
</div>

<div class="fz fz-sticky-mobile">
  <div class="fz-sticky-mobile__row">
    {%- form 'product', product -%}
      <input type="hidden" name="id" value="{{ variant.id }}">
      <button type="submit" class="fz-sticky-mobile__atc">Add 2 to cart &mdash; AED 219</button>
    {%- endform -%}
    <a href="{{ section.settings.whatsapp_link | default: '#' }}" class="fz-sticky-mobile__wa" aria-label="WhatsApp us">WA</a>
  </div>
  <div class="fz-sticky-mobile__note">Free delivery &middot; arrives Sun 17 Aug &middot; no timers here</div>
</div>
